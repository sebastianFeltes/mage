# gemini | anthropic | openai
MAGE_PROVIDER=gemini

# Modelos rápidos (plan, corrección). El costo de latencia vive aquí.
MAGE_FAST_MODEL=gemini-3.6-flash
MAGE_REASON_MODEL=gemini-3.1-pro-preview

GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# none = sin search semántico (grafo/FTS). gemini | openai para embeddings cloud.
MAGE_EMBED_PROVIDER=none

# sqlite (default, sin Docker) | falkor | off
MAGE_GRAPH=sqlite
FALKOR_HOST=127.0.0.1
FALKOR_PORT=6379
FALKOR_GRAPH=mage

MAGE_VEC_PATH=./data/mage.vec.db
MAGE_PORT=3920
MAGE_HOST=127.0.0.1
MAGE_WASM_TIMEOUT_MS=50
MAGE_ENRICH_BUDGET_MS=25
MAGE_MAX_ATTEMPTS=3
MAGE_FAST_PATH_CONFIDENCE=0.5

# Auth HTTP. Obligatoria si MAGE_HOST no es loopback.
MAGE_API_KEY=

# CORS: orígenes separados por coma. Vacío = sin CORS. Nunca *.
MAGE_CORS_ORIGINS=

# Rate limit de /v1/query* (req/min/IP)
MAGE_RATE_LIMIT_PER_MIN=60
MAGE_REQUEST_TIMEOUT_MS=60000

# script.run: experimental, no es un sandbox. Default off. No lo prendas en serve.
MAGE_SCRIPT_ENABLED=0
MAGE_SCRIPT_TIMEOUT_MS=2000

# Si Gemini/OpenAI agota cuota, intenta Ollama local (ollama pull llama3.2)
MAGE_FALLBACK_OLLAMA=1
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
MAGE_OLLAMA_MODEL=llama3.2

# Sesiones (sqlite por default; memory si MAGE_SESSION_STORE=memory)
MAGE_SESSION_ENABLED=1
MAGE_SESSION_MAX_TURNS=20
MAGE_SESSION_TTL_MS=86400000
MAGE_SESSION_PATH=./data/sessions.sqlite
MAGE_SESSION_STORE=sqlite
MAGE_FACTS_PATH=./data/facts.sqlite
